/target

# Vendored faer (see docs/FAER_ITERATE_LANCZOS_FIX.md). Track source only;
# build artifacts and upstream-CI dotfiles stay local.
faer/target/
faer/.git/
faer/.claude/
faer/*.out
faer/*.pdf
faer/compile_commands.json

# Override global gitignore for project-specific .claude config
!.claude/
!.claude/**
.claude/settings.local.json
.claude/locks/*.lock
.claude/locks/*.lock.d/
qe-7.5/
# Ignore untracked scratch under scripts/ but keep committed validation helpers.
scripts/*
!scripts/validate/
*.tar.gz
*.tgz

# Partial browser downloads
Unconfirmed*
*.crdownload
*.part
