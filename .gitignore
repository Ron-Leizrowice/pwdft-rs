/target

# Vendored faer (see docs/FAER_ITERATE_LANCZOS_FIX.md). Track source only;
# build artifacts and upstream-CI dotfiles stay local.
pwdft/faer/target/
pwdft/faer/.git/
pwdft/faer/.claude/
pwdft/faer/*.out
pwdft/faer/*.pdf
pwdft/faer/compile_commands.json

# Override global gitignore for project-specific .claude config
!.claude/
!.claude/**
.claude/settings.local.json
.claude/locks/*.lock
.claude/locks/*.lock.d/

# Scratch QE build tree, browser partials, archives.
qe-7.5/
*.tar.gz
*.tgz
Unconfirmed*
*.crdownload
*.part

# outputs/ is a scratch dir for SCF runs; keep the dir (via .gitkeep) but
# ignore everything else.
outputs/*
!outputs/.gitkeep

# Python tooling (uv / hatchling) for validation package.
__pycache__/
.venv/
cache-dir = "~/.cache/ruff"
