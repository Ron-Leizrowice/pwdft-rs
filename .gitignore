target/

# Vendored faer (see CLAUDE.md § Vendored dependencies). Source tracked - upstream-CI / build byproducts stay local.
pwdft/faer/.git/
pwdft/faer/.claude/
pwdft/faer/*.out
pwdft/faer/*.pdf
pwdft/faer/compile_commands.json

# Claude Code project config — everything under .claude/ is tracked by default; these are the only carve-outs.
.claude/settings.local.json
.claude/locks/*.lock
.claude/locks/*.lock.d/

# QE 7.5 tree — either a local build or a symlink created by setup.sh.
qe-7.5
qe-7.5/

# Machine-local config consumed by setup.sh. Template is .env.example.
.env

# outputs/ is a scratch dir for SCF runs; keep the dir (via .gitkeep) but
# ignore everything else.
outputs/*
!outputs/.gitkeep

# Python tooling (uv / hatchling) for validation package.
__pycache__/
.venv/
.cache/
