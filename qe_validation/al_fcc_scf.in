&CONTROL
  calculation = 'scf'
  prefix = 'al'
  outdir = './tmp'
  pseudo_dir = './pseudo'
  verbosity = 'high'
  disk_io = 'low'
  max_seconds = 540
/
&SYSTEM
  ibrav = 2
  celldm(1) = 7.6527
  nat = 1
  ntyp = 1
  ecutwfc = 15.0
  ecutrho = 60.0
  occupations = 'smearing'
  smearing = 'fermi-dirac'
  degauss = 0.02
  nspin = 1
/
&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.3
  mixing_mode = 'local-TF'
  electron_maxstep = 60
  diagonalization = 'david'
/
ATOMIC_SPECIES
  Al  26.982  Al.upf

ATOMIC_POSITIONS crystal
  Al 0.00 0.00 0.00

K_POINTS automatic
  8 8 8  0 0 0
