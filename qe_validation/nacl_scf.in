&CONTROL
  calculation = 'scf'
  prefix = 'nacl'
  outdir = './tmp'
  pseudo_dir = './pseudo'
  verbosity = 'high'
  disk_io = 'low'
  max_seconds = 540
/
&SYSTEM
  ibrav = 2
  celldm(1) = 10.6078
  nat = 2
  ntyp = 2
  ecutwfc = 25.0
  ecutrho = 100.0
  occupations = 'smearing'
  smearing = 'fermi-dirac'
  degauss = 0.01
  nspin = 1
/
&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.3
  electron_maxstep = 60
  diagonalization = 'david'
/
ATOMIC_SPECIES
  Na  22.990  Na.upf
  Cl  35.453  Cl.upf

ATOMIC_POSITIONS crystal
  Na 0.00 0.00 0.00
  Cl 0.50 0.50 0.50

K_POINTS automatic
  4 4 4  0 0 0
