&CONTROL
  calculation = 'scf'
  prefix = 'gaas_pbe'
  outdir = './tmp_pbe'
  pseudo_dir = './pseudo_pbe'
  verbosity = 'high'
  disk_io = 'low'
  max_seconds = 540
/
&SYSTEM
  ibrav = 2
  celldm(1) = 10.6829
  nat = 2
  ntyp = 2
  ecutwfc = 44.0
  ecutrho = 176.0
  input_dft = 'pbe'
  occupations = 'smearing'
  smearing = 'fermi-dirac'
  degauss = 0.01
  nspin = 1
/
&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.3
  electron_maxstep = 60
  diagonalization = 'david'
/
ATOMIC_SPECIES
  Ga  69.723  Ga.upf
  As  74.922  As.upf

ATOMIC_POSITIONS crystal
  Ga 0.00 0.00 0.00
  As 0.25 0.25 0.25

K_POINTS automatic
  4 4 4  0 0 0
