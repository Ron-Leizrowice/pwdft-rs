&CONTROL
  calculation = 'scf'
  prefix = 'cu'
  outdir = './tmp'
  pseudo_dir = './pseudo'
  verbosity = 'high'
  disk_io = 'low'
  max_seconds = 540
/
&SYSTEM
  ibrav = 2
  celldm(1) = 6.8219
  nat = 1
  ntyp = 1
  ecutwfc = 25.0
  ecutrho = 100.0
  occupations = 'smearing'
  smearing = 'fermi-dirac'
  degauss = 0.02
  nspin = 1
/
&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.3
  mixing_mode = 'local-TF'
  electron_maxstep = 60
  diagonalization = 'david'
/
ATOMIC_SPECIES
  Cu  63.546  Cu.upf

ATOMIC_POSITIONS crystal
  Cu 0.00 0.00 0.00

K_POINTS automatic
  8 8 8  0 0 0
