# Copy to .env and fill in machine-local values. Consumed by setup.sh.

# Python interpreter pinned via uv. Must match pyproject.toml's requires-python.
UV_PYTHON=3.14.4t

# Path to a Quantum ESPRESSO 7.5 build tree (must contain build/bin/pw.x).
# setup.sh symlinks this to ./qe-7.5.
QE_PATH=/path/to/qe-7.5
