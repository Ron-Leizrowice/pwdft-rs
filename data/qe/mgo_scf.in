&CONTROL
  calculation = 'scf'
  prefix = 'mgo'
  outdir = './tmp'
  pseudo_dir = '../../../pseudopotentials/nc/lda'
  verbosity = 'high'
  disk_io = 'low'
  max_seconds = 540
/
&SYSTEM
  ibrav = 2
  celldm(1) = 7.9586
  nat = 2
  ntyp = 2
  ecutwfc = 30.0
  ecutrho = 120.0
  occupations = 'smearing'
  smearing = 'fermi-dirac'
  degauss = 0.01
  nspin = 1
/
&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.3
  electron_maxstep = 60
  diagonalization = 'david'
/
ATOMIC_SPECIES
  Mg  24.305  Mg.upf
  O   15.999  O.upf

ATOMIC_POSITIONS crystal
  Mg 0.00 0.00 0.00
  O  0.50 0.50 0.50

K_POINTS automatic
  4 4 4  0 0 0
